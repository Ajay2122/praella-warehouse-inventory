NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/warehouse_inventory?schema=public"

# Auth - generate a real random secret for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-random-32-plus-character-secret"
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Redis (cache + BullMQ)
REDIS_URL="redis://localhost:6379"

# CORS - the client's origin
CORS_ORIGIN="http://localhost:5173"
